# The AS Travel platform API (as-travel-platform-api), including /api/v1. The
# app calls it directly, so the API's CORS_ALLOWED_ORIGINS must list this app's
# origin (e.g. https://app.astravel.com). Fixed at build time.
VITE_API_URL=https://p-api.astravel.com/api/v1

# The API's Web Push VAPID public key (WEBPUSH_VAPID_PUBLIC_KEY there, made with
# `php artisan webpush:vapid`), so phones subscribe with the key the server
# signs pushes with. Fixed at build time.
VITE_WEBPUSH_PUBLIC_KEY=
